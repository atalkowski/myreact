
for i in Screenshot_*; do
  open $i
  echo "Opened $i"
  echo "To rename this screen shot type in the new name now (or [Q]uit) blank will skip"
  read answer
  case "$answer" in
  q | Q) break;; 
  *) answer=`echo "$answer" | sed 's/ //g'` 
     if [ "$answer" != "" ]; then
         mv $i "$answer"
         echo "Moved $i to $answer"
     else
	echo "Skipped rename of $i"
     fi
  ;;
  esac
done

